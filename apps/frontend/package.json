{
  "name": "@portfolio/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:vercel-engines": "node ../../tools/check-vercel-engines.mjs",
    "dev": "next dev",
    "dev:docker": "node ../../tools/ensure-storybook-public.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "install:strict": "node ../../tools/run-warning-free.mjs --label \"frontend install\" --env NODE_OPTIONS=--no-deprecation -- yarn install --frozen-lockfile",
    "prebuild": "node ../../tools/build-storybook-for-next.mjs",
    "build": "next build",
    "build:strict": "node ../../tools/run-warning-free.mjs --label \"frontend build\" -- yarn build",
    "start": "next start",
    "start:docker": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "format:repo": "prettier --write ../../README.md ../../AGENTS.md ../../docs ../../.github ../../.prettierrc.json ../../package.json ../../vercel.json --ignore-path ../../.prettierignore",
    "format:repo:check": "prettier --check ../../README.md ../../AGENTS.md ../../docs ../../.github ../../.prettierrc.json ../../package.json ../../vercel.json --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@portfolio/resume-content": "file:../../packages/resume-content",
    "@portfolio/storybook": "file:../../packages/storybook",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.9",
    "posthog-js": "^1.379.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "^24.1.3",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "storybook": "^10.3.5",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
