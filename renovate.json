{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "prConcurrentLimit": 1,
  "automergeType": "pr",
  "platformAutomerge": true,
  "major": {
    "automerge": true
  },
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Skip vestigial Vercel root shim; apps/frontend owns real deps",
      "matchManagers": ["npm"],
      "matchFileNames": ["^package.json$"],
      "enabled": false
    },
    {
      "description": "Group shared dev tooling bumped across lockfiles",
      "groupName": "eslint",
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "eslint-config-next",
        "eslint-plugin-playwright",
        "typescript-eslint"
      ]
    },
    {
      "groupName": "prettier",
      "matchPackageNames": ["prettier"]
    },
    {
      "groupName": "typescript",
      "matchPackageNames": ["typescript", "@types/node"]
    },
    {
      "groupName": "playwright",
      "matchPackageNames": ["playwright", "@playwright/test"]
    },
    {
      "groupName": "vitest",
      "matchPackageNames": ["vitest", "/^@vitest//"]
    },
    {
      "description": "Block TypeScript 7 until eslint + Next support it without experimental flags",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "allowedVersions": "<7",
      "prBodyNotes": [
        "Deferred until TypeScript 7.1 ships a stable programmatic API, typescript-eslint widens its peer range, and Next.js supports TS7 on the default build path (no experimental flags). See renovate.json packageRules."
      ]
    }
  ]
}
