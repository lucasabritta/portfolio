{
  "name": "@portfolio/storybook",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": "./src/index.ts",
    "./build-page": {
      "types": "./src/build-page/index.ts",
      "default": "./src/build-page/index.ts"
    },
    "./foundations": {
      "types": "./src/foundations/index.ts",
      "default": "./src/foundations/index.ts"
    },
    "./home": {
      "types": "./src/home/index.ts",
      "default": "./src/home/index.ts"
    },
    "./home-marketing": {
      "types": "./src/home-marketing/index.ts",
      "default": "./src/home-marketing/index.ts"
    },
    "./hero": {
      "types": "./src/hero/index.ts",
      "default": "./src/hero/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "default": "./src/primitives/index.ts"
    },
    "./projects-page": {
      "types": "./src/projects-page/index.ts",
      "default": "./src/projects-page/index.ts"
    },
    "./projects-page-view": {
      "types": "./src/projects-page/projects-page-view.tsx",
      "default": "./src/projects-page/projects-page-view.tsx"
    },
    "./site-chrome": {
      "types": "./src/site-chrome/index.ts",
      "default": "./src/site-chrome/index.ts"
    },
    "./status-page": {
      "types": "./src/status-page/index.ts",
      "default": "./src/status-page/index.ts"
    },
    "./globals.css": "./src/globals.css",
    "./layout.module.css": "./src/layout.module.css"
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "install:strict": "node ../../tools/run-warning-free.mjs --label \"storybook install\" --env NODE_OPTIONS=--no-deprecation -- yarn install --frozen-lockfile",
    "build-storybook": "storybook build",
    "build-storybook:strict": "node ../../tools/run-warning-free.mjs --label \"storybook build\" --env VITE_CJS_IGNORE_WARNING=true -- yarn build-storybook",
    "test:storybook": "vitest run --config vitest.config.mjs",
    "lint": "eslint --max-warnings=0 src .storybook",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "yarn test:storybook",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@storybook/react": "10.4.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "4.1.10",
    "eslint": "^9.39.4",
    "next": "16.2.9",
    "playwright": "^1.59.1",
    "prettier": "3.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "^10.3.5",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
